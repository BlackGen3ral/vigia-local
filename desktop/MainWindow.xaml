<Window x:Class="Vigia.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:Vigia" Title="Vigia Local" Width="1240" Height="790"
 MinWidth="880" MinHeight="620" Background="#11141B" Foreground="#F0F3F7" WindowStartupLocation="CenterScreen" Icon="vigia.ico"
 FontFamily="Segoe UI" UseLayoutRounding="True">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="215"/><ColumnDefinition/></Grid.ColumnDefinitions>
  <Border Background="#151922" BorderBrush="#2C3341" BorderThickness="0,0,1,0" Padding="16,25,16,17">
   <DockPanel LastChildFill="False">
    <StackPanel DockPanel.Dock="Top">
     <StackPanel Orientation="Horizontal" Margin="4,0,0,31">
      <Border Width="40" Height="40" CornerRadius="11" Background="{StaticResource Accent}">
       <Path Width="21" Height="21" Stretch="Uniform" Stroke="#193C2C" StrokeThickness="1.8"
             Data="M1,7 V1 H7 M15,1 H21 V7 M21,15 V21 H15 M7,21 H1 V15 M15,11 A4,4 0 1 1 7,11 A4,4 0 1 1 15,11"/>
      </Border>
      <StackPanel Margin="10,1,0,0">
       <TextBlock Text="Vigia Local" FontSize="19" FontWeight="SemiBold"/>
       <TextBlock Text="Monitoramento de loja" FontSize="10" Foreground="{StaticResource Muted}"/>
      </StackPanel>
     </StackPanel>
     <TextBlock Text="ÁREA DE TRABALHO" Style="{StaticResource Eyebrow}" Margin="11,0,0,9"/>
     <Button x:Name="MonitorNav" Style="{StaticResource NavButton}" Click="Monitor_Click">
      <StackPanel Orientation="Horizontal"><Path Width="16" Height="16" Stretch="Uniform" Stroke="#A8ECC8" StrokeThickness="1.5" Data="M1,4 H12 V13 H1 Z M12,7 L17,4 V13 L12,10"/><TextBlock Text="Monitoramento" Margin="10,0,0,0"/></StackPanel>
     </Button>
     <Button x:Name="TeamNav" Style="{StaticResource NavButton}" Click="Team_Click" Margin="0,4,0,0">
      <StackPanel Orientation="Horizontal"><Path Width="16" Height="16" Stretch="Uniform" Stroke="#A8ECC8" StrokeThickness="1.5" Data="M10,6 A4,4 0 1 1 2,6 A4,4 0 1 1 10,6 M0,17 C0,11 12,11 12,17 M13,3 C18,4 18,9 14,10 M14,13 C17,13 19,15 19,17"/><TextBlock Text="Equipe e avisos" Margin="10,0,0,0"/></StackPanel>
     </Button>
     <Button x:Name="SettingsNav" Style="{StaticResource NavButton}" Click="Settings_Click" Margin="0,4,0,0">
      <StackPanel Orientation="Horizontal"><Path Width="16" Height="16" Stretch="Uniform" Stroke="#A8ECC8" StrokeThickness="1.5" Data="M0,3 H17 M0,9 H17 M0,15 H17 M5,0 V6 M12,6 V12 M7,12 V18"/><TextBlock Text="Configurações" Margin="10,0,0,0"/></StackPanel>
     </Button>
    </StackPanel>
    <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Padding="11">
     <StackPanel>
      <TextBlock Text="Processamento local" FontWeight="SemiBold" FontSize="12"/>
      <TextBlock Text="O vídeo fica no PC da loja." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"/>
     </StackPanel>
    </Border>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1">
   <local:CameraView x:Name="Camera"/>
   <ScrollViewer x:Name="TeamPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="32,28,32,28" MaxWidth="790" HorizontalAlignment="Left">
     <TextBlock Text="ACESSO DA EQUIPE" Style="{StaticResource Eyebrow}"/>
     <TextBlock Text="Equipe e avisos" FontSize="31" FontWeight="SemiBold" Margin="0,5,0,6"/>
     <TextBlock Text="Compartilhe o acesso com quem deve acompanhar a entrada." Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
     <Border Style="{StaticResource Card}" Margin="0,24,0,12">
      <StackPanel>
       <TextBlock Text="Convite da loja" FontSize="17" FontWeight="SemiBold"/>
       <StackPanel x:Name="EnrollmentPanel" Margin="0,13,0,0">
        <TextBlock Text="Chave de instalação" Style="{StaticResource FieldLabel}"/>
        <PasswordBox x:Name="Enrollment" MaxWidth="360" HorizontalAlignment="Stretch" AutomationProperties.Name="Chave de instalação"/>
        <Button x:Name="ActivateButton" Content="Vincular esta loja" Click="Activate_Click" HorizontalAlignment="Left" Margin="0,10,0,0"/>
       </StackPanel>
       <WrapPanel Margin="0,13,0,0">
        <Button x:Name="CopyButton" Content="Copiar código de convite" Click="Copy_Click" Visibility="Collapsed" Margin="0,0,8,6"/>
        <Button x:Name="TestButton" Content="Enviar aviso de teste" Click="Test_Click" Style="{StaticResource SecondaryButton}" Visibility="Collapsed" Margin="0,0,0,6"/>
       </WrapPanel>
       <TextBlock x:Name="InviteCodeLabel" Visibility="Collapsed" FontFamily="Consolas" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="0,9,0,0"/>
       <TextBlock x:Name="CloudStatus" Text="Loja ainda não vinculada" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
       <CheckBox x:Name="IncludeThumbnail" Content="Incluir imagem da câmera nos avisos" Foreground="#F0F3F7" Click="Thumbnail_Click" Margin="0,15,0,6"/>
       <TextBlock Text="Envia uma miniatura de até 24 KB por chegada. O link da imagem expira em 10 minutos." Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
      </StackPanel>
     </Border>
     <Border Style="{StaticResource Card}">
      <StackPanel>
       <TextBlock Text="No celular" FontSize="16" FontWeight="SemiBold"/>
       <TextBlock Text="Abra vigia-local.pages.dev, toque em Abrir painel e informe o código. Depois, ative os avisos neste aparelho." Foreground="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap"/>
      </StackPanel>
     </Border>
    </StackPanel>
   </ScrollViewer>
   <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="32,28,32,28" MaxWidth="790" HorizontalAlignment="Left">
     <TextBlock Text="PREFERÊNCIAS DO COMPUTADOR" Style="{StaticResource Eyebrow}"/>
     <TextBlock Text="Configurações" FontSize="31" FontWeight="SemiBold" Margin="0,5,0,6"/>
     <Border Style="{StaticResource Card}" Margin="0,20,0,12">
      <StackPanel>
       <TextBlock Text="Em segundo plano" FontSize="17" FontWeight="SemiBold"/>
       <CheckBox x:Name="StartWithWindows" Content="Iniciar com o Windows" Foreground="#F0F3F7" Margin="0,13,0,8" Click="Startup_Click"/>
       <TextBlock Text="Fechar a janela mantém o Vigia ativo na bandeja perto do relógio." Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
      </StackPanel>
     </Border>
     <Border Style="{StaticResource Card}">
      <StackPanel>
       <TextBlock Text="Atualizações" FontSize="17" FontWeight="SemiBold"/>
       <TextBlock x:Name="VersionLabel" Foreground="{StaticResource Muted}" Margin="0,7,0,10"/>
       <Button x:Name="UpdateButton" Content="Verificar atualizações" Click="Update_Click" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"/>
       <TextBlock x:Name="UpdateStatus" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
      </StackPanel>
     </Border>
     <Button Content="Encerrar Vigia Local" Click="Quit_Click" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,16,0,0"/>
    </StackPanel>
   </ScrollViewer>
  </Grid>
 </Grid>
</Window>
