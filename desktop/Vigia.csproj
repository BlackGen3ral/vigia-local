<Project Sdk="Microsoft.NET.Sdk">
 <PropertyGroup>
  <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework>
  <UseWPF>true</UseWPF><UseWindowsForms>true</UseWindowsForms><Nullable>enable</Nullable>
  <Version>1.4.1</Version><AssemblyName>VigiaLocal</AssemblyName><Product>Vigia Local</Product>
  <ApplicationIcon>vigia.ico</ApplicationIcon>
 </PropertyGroup>
 <ItemGroup>
  <PackageReference Include="OpenCvSharp4.Windows" Version="4.13.0.20260627"/>
  <PackageReference Include="System.Speech" Version="10.0.0"/>
  <Resource Include="vigia.ico"/>
  <EmbeddedResource Include="Assets\arrival.wav" LogicalName="Vigia.Arrival.wav"/>
  <Content Include="..\voice\*.mp3" Link="voice\%(Filename)%(Extension)"
   CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/>
  <EmbeddedResource Include="CameraModel\yolox-s.onnx" LogicalName="Vigia.Camera.YoloX.onnx"/>
  <Content Include="CameraModel\YOLOX-LICENSE.txt" CopyToPublishDirectory="PreserveNewest" TargetPath="YOLOX-LICENSE.txt"/>
 </ItemGroup>
</Project>
