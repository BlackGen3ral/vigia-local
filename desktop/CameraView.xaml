<UserControl x:Class="Vigia.CameraView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer VerticalScrollBarVisibility="Auto">
  <StackPanel Margin="32,26,32,24" MaxWidth="760">
   <TextBlock Text="MONITORAMENTO LOCAL" Foreground="#7BC9E8" FontSize="11" FontWeight="SemiBold"/>
   <TextBlock Text="Câmeras da loja" FontSize="28" FontWeight="SemiBold" Margin="0,5,0,6"/>
   <TextBlock Text="Intelbras · Selecione a área da porta para detectar a presença de pessoas." Foreground="#ADB8C4" TextWrapping="Wrap"/>
   <Border Background="#18212B" CornerRadius="12" Padding="15" Margin="0,16,0,12">
    <StackPanel>
     <UniformGrid x:Name="ConnectionFields" Columns="5">
      <StackPanel Margin="0,0,8,0">
       <TextBlock Text="IP local do DVR" Margin="0,0,0,5"/>
       <TextBox x:Name="Host" AutomationProperties.Name="IP local do DVR"/>
      </StackPanel>
      <StackPanel Margin="0,0,8,0">
       <TextBlock Text="Porta RTSP" Margin="0,0,0,5"/>
       <TextBox x:Name="Port" Text="554" AutomationProperties.Name="Porta RTSP"/>
      </StackPanel>
      <StackPanel Margin="0,0,8,0">
       <TextBlock Text="Canal" Margin="0,0,0,5"/>
       <TextBox x:Name="Channel" Text="1" AutomationProperties.Name="Canal"/>
      </StackPanel>
      <StackPanel Margin="0,0,8,0">
       <TextBlock Text="Usuário do DVR" Margin="0,0,0,5"/>
       <TextBox x:Name="Login" AutomationProperties.Name="Usuário do DVR"/>
      </StackPanel>
      <StackPanel>
       <TextBlock Text="Senha do DVR" Margin="0,0,0,5"/>
       <PasswordBox x:Name="Secret" Padding="6" AutomationProperties.Name="Senha do DVR"/>
      </StackPanel>
     </UniformGrid>
     <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
      <Button x:Name="ConnectButton" Content="Conectar câmera" Click="Connect_Click"/>
      <Button x:Name="StopButton" Content="Desconectar" Click="Stop_Click" IsEnabled="False" Margin="8,0,0,0"/>
     </StackPanel>
    </StackPanel>
   </Border>
   <TextBlock x:Name="CameraStatus" Text="Câmera desconectada" Foreground="#9DDCF0" TextWrapping="Wrap" Margin="0,0,0,8"/>
   <Border Background="#0A0E14" BorderBrush="#2A3A48" BorderThickness="1" CornerRadius="8">
    <Viewbox Stretch="Uniform" MaxHeight="360">
     <Grid x:Name="PreviewSurface" Width="640" Height="360" Background="Transparent" Cursor="Cross"
           MouseLeftButtonDown="Zone_Down" MouseMove="Zone_Move" MouseLeftButtonUp="Zone_Up"
           LostMouseCapture="Zone_LostCapture">
      <TextBlock Text="A imagem aparece aqui após a conexão" Foreground="#ADB8C4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      <Image x:Name="Preview" Stretch="Fill" IsHitTestVisible="False"/>
      <Canvas IsHitTestVisible="False">
       <Rectangle x:Name="ZoneOutline" Stroke="#7BC9E8" StrokeThickness="2" Fill="#247BC9E8" Visibility="Collapsed"/>
      </Canvas>
     </Grid>
    </Viewbox>
   </Border>
   <TextBlock Text="Arraste um retângulo sobre o piso na região da porta. O ponto sob cada pessoa mostra onde ela é detectada. O Vigia pode continuar na bandeja do Windows." Foreground="#ADB8C4" TextWrapping="Wrap" Margin="0,9,0,0"/>
   <TextBlock x:Name="EventStatus" Text="Nenhuma presença detectada nesta sessão." Margin="0,8,0,0" TextWrapping="Wrap"/>
  </StackPanel>
 </ScrollViewer>
</UserControl>
